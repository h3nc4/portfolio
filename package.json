{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "lint": "eslint .",
    "lint:md": "rumdl check README.md",
    "lint:sh": "shellcheck -o all scripts/*.sh",
    "lint:type": "sh scripts/lint-type.sh",
    "typecheck": "astro check",
    "format:check": "prettier --check .",
    "preview": "astro preview",
    "test:browser": "vitest --config vitest.config.browser.ts",
    "test": "vitest run --coverage; s=$?; mv coverage/lcov.info coverage.lcov; rm -rf coverage; exit $s",
    "audit": "npm audit --audit-level=high"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "26.6.10",
    "@types/react": "19.3.2",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "5.1.1",
    "@vitest/coverage-v8": "5.1.1",
    "astro": "7.4.13",
    "astro-eslint-parser": "3.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "eslint": "10.15.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-jest-dom": "5.11.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-testing-library": "7.16.3",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "lint-staged": "17.6.2",
    "lucide-react": "1.80.0",
    "playwright": "1.65.1",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "prettier-plugin-tailwindcss": "0.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "5.7.0",
    "rumdl": "0.3.6",
    "tailwind-merge": "3.7.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.1"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/spectral": "5.3.0"
  }
}
