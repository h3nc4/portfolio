                      "id": "lan.gems.docker.quiet.rest",
                      "kind": "service",
                      "label": "restic-rest"
                    },
                    {
                      "id": "lan.gems.docker.quiet.jelly",
                      "kind": "service",
                      "label": "jellyfin"
                    },
                    {
                      "id": "lan.gems.docker.quiet.prom",
                      "kind": "service",
                      "label": "prometheus"
                    },
                    {
                      "id": "lan.gems.docker.quiet.alert",
                      "kind": "service",
                      "label": "alertmanager"
                    },
                    {
                      "id": "lan.gems.docker.quiet.graf",
                      "kind": "service",
                      "label": "grafana"
                    },
                    {
                      "id": "lan.gems.docker.quiet.loki",
                      "kind": "service",
                      "label": "loki"
                    },
                    {
                      "id": "lan.gems.docker.quiet.gatus",
                      "kind": "service",
                      "label": "gatus"
                    },
                    {
                      "id": "lan.gems.docker.quiet.gnode",
                      "kind": "service",
                      "label": "node-exporter"
                    },
                    {
                      "id": "lan.gems.docker.quiet.gcadv",
                      "kind": "service",
                      "label": "cadvisor"
                    },
                    {
                      "id": "lan.gems.docker.quiet.gptail",
                      "kind": "service",
                      "label": "promtail"
                    },
                    {
                      "id": "lan.gems.docker.quiet.grunner",
                      "kind": "service",
                      "label": "forgejo-runner",
                      "note": "docker socket"
                    }
                  ]
                }
              ]
            },
            {
              "id": "lan.gems.vm",
              "kind": "runtime",
              "label": "libvirt NAT",
              "addr": "virbr0",
              "children": [
                {
                  "id": "lan.gems.vm.cic",
                  "kind": "service",
                  "label": "ci-c",
                  "items": ["forgejo-runner"]
                },
                {
                  "id": "lan.gems.vm.cid",
                  "kind": "service",
                  "label": "ci-d",
                  "items": ["forgejo-runner"]
                }
              ]
            }
