                    {
                      "id": "lan.gems.docker.bridged.tproxy",
                      "kind": "service",
                      "label": "tls-proxy",
                      "ports": ["443"]
                    },
                    {
                      "id": "lan.gems.docker.bridged.dns2",
                      "kind": "service",
                      "label": "CoreDNS",
                      "note": "DoT on 853",
                      "ports": ["53", "853"]
