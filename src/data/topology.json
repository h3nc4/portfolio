                      "label": "syncthing",
                      "ports": ["22000", "21027"]
                    },
                    {
                      "id": "lan.gems.docker.netns.gtor",
                      "kind": "service",
                      "label": "tor",
                      "note": "SOCKS",
                      "ports": ["9050"]
