{
  "nodes": [
    {
      "id": "internet",
      "kind": "zone",
      "label": "Internet",
      "col": 0,
      "children": [
        {
          "id": "internet.visitor",
          "kind": "service",
          "label": "web visitor"
        },
        {
          "id": "internet.mta",
          "kind": "service",
          "label": "sending MTA"
        },
        {
          "id": "internet.peer",
          "kind": "service",
          "label": "WireGuard peer",
          "note": "remote"
        },
        {
          "id": "internet.censored",
          "kind": "service",
          "label": "Tor client",
          "note": "censored"
        },
        {
          "id": "internet.hidden",
          "kind": "group",
          "label": "Hidden internet",
          "children": [
            {
              "id": "internet.hidden.user",
              "kind": "service",
              "label": "Tor user"
            }
          ]
        }
      ]
    },
    {
      "id": "cf",
      "kind": "zone",
      "label": "Cloudflare",
      "col": 1,
      "children": [
        {
          "id": "cf.edge",
          "kind": "service",
          "label": "edge + WAF"
        }
      ]
    },
    {
      "id": "router",
      "kind": "device",
      "label": "router",
      "col": 1
    },
    {
      "id": "lan",
      "kind": "zone",
      "label": "LAN",
      "col": 2,
      "children": [
        {
          "id": "lan.gem",
          "kind": "machine",
          "label": "gem server",
          "children": [
            {
              "id": "lan.gem.onhost",
              "kind": "runtime",
              "label": "on the host",
              "children": [
                {
                  "id": "lan.gem.onhost.sshd",
                  "kind": "service",
                  "label": "sshd",
                  "ports": ["22"]
                },
                {
                  "id": "lan.gem.onhost.wg",
                  "kind": "service",
                  "label": "wireguard",
                  "note": "kernel",
                  "ports": ["51820"]
                },
                {
                  "id": "lan.gem.onhost.ops",
                  "kind": "service",
                  "label": "nftables",
                  "items": ["cron", "ntpd"]
                }
              ]
            },
            {
              "id": "lan.gem.docker",
              "kind": "runtime",
              "label": "Docker",
              "addr": "lanhost",
              "children": [
                {
                  "id": "lan.gem.docker.netns",
                  "kind": "group",
                  "label": "host network",
                  "children": [
                    {
                      "id": "lan.gem.docker.netns.wgui",
                      "kind": "service",
                      "label": "wg-easy UI",
                      "note": "br-lanhost",
                      "ports": ["51821"]
                    },
                    {
                      "id": "lan.gem.docker.netns.sync",
                      "kind": "service",
                      "label": "syncthing",
                      "note": "br-lanhost",
                      "ports": ["22000", "21027", "8384"]
                    },
                    {
                      "id": "lan.gem.docker.netns.snow",
                      "kind": "service",
                      "label": "snowflake-proxy",
                      "ports": ["40000-40040"]
                    },
                    {
                      "id": "lan.gem.docker.netns.tddns",
                      "kind": "service",
                      "label": "tddns"
                    }
                  ]
                },
                {
                  "id": "lan.gem.docker.bridged",
                  "kind": "group",
                  "label": "published by docker-proxy",
                  "children": [
                    {
                      "id": "lan.gem.docker.bridged.proxy",
                      "kind": "service",
                      "label": "lan-proxy",
                      "ports": ["443"]
                    },
                    {
                      "id": "lan.gem.docker.bridged.maddy",
                      "kind": "service",
                      "label": "maddy",
                      "ports": ["25", "587", "993"]
                    },
                    {
                      "id": "lan.gem.docker.bridged.dns",
                      "kind": "service",
                      "label": "CoreDNS",
                      "note": "DoT on 853",
                      "ports": ["53", "853"]
                    },
                    {
                      "id": "lan.gem.docker.bridged.forgejo",
                      "kind": "service",
                      "label": "forgejo",
                      "note": "ssh",
                      "ports": ["2222"]
                    },
                    {
                      "id": "lan.gem.docker.bridged.tor",
                      "kind": "service",
                      "label": "tor",
                      "note": "SOCKS, hidden service",
                      "ports": ["9050"]
                    },
                    {
                      "id": "lan.gem.docker.bridged.mc",
                      "kind": "service",
                      "label": "minecraft",
                      "ports": ["25565"]
                    }
                  ]
                },
                {
                  "id": "lan.gem.docker.quiet",
                  "kind": "group",
                  "label": "no published port",
                  "children": [
                    {
                      "id": "lan.gem.docker.quiet.cfd",
                      "kind": "service",
                      "label": "cloudflared"
                    },
                    {
                      "id": "lan.gem.docker.quiet.torrp",
                      "kind": "service",
                      "label": "tor-reverse-proxy"
                    },
                    {
                      "id": "lan.gem.docker.quiet.web",
                      "kind": "service",
                      "label": "h3nc4",
                      "items": ["wasudoku"]
                    },
                    {
                      "id": "lan.gem.docker.quiet.pub",
                      "kind": "service",
                      "label": "cgit",
                      "items": ["http-static"]
                    },
                    {
                      "id": "lan.gem.docker.quiet.none",
                      "kind": "service",
                      "label": "forgejo-db",
                      "items": ["renovate", "restic"]
                    },
                    {
                      "id": "lan.gem.docker.quiet.bolao",
                      "kind": "service",
                      "label": "private service",
                      "hidden": true
                    },
                    {
                      "id": "lan.gem.docker.quiet.rgems",
                      "kind": "service",
                      "label": "restic-gems",
                      "note": "copy to gems"
                    },
                    {
                      "id": "lan.gem.docker.quiet.offs",
                      "kind": "service",
                      "label": "media-offsite",
                      "note": "encrypted, to the offsite mesh"
                    },
                    {
                      "id": "lan.gem.docker.quiet.ptail",
                      "kind": "service",
                      "label": "promtail",
                      "note": "push to gems"
                    },
                    {
                      "id": "lan.gem.docker.quiet.runner",
                      "kind": "service",
                      "label": "forgejo-runner",
                      "note": "docker socket"
                    },
                    {
                      "id": "lan.gem.docker.quiet.nodeexp",
                      "kind": "service",
                      "label": "node-exporter"
                    },
                    {
                      "id": "lan.gem.docker.quiet.cadv",
                      "kind": "service",
                      "label": "cadvisor"
                    },
                    {
                      "id": "lan.gem.docker.quiet.sonar",
                      "kind": "service",
                      "label": "sonarqube",
                      "items": ["sonarqube-db"]
                    }
                  ]
                }
              ]
            },
            {
              "id": "lan.gem.vm",
              "kind": "runtime",
              "label": "libvirt NAT",
              "addr": "virbr0",
              "children": [
                {
                  "id": "lan.gem.vm.dnsmasq",
                  "kind": "service",
                  "label": "dnsmasq",
                  "note": "DHCP and DNS",
                  "ports": ["67", "53"]
                },
                {
                  "id": "lan.gem.vm.cia",
                  "kind": "service",
                  "label": "ci-a",
                  "items": ["forgejo-runner"]
                },
                {
                  "id": "lan.gem.vm.cib",
                  "kind": "service",
                  "label": "ci-b",
                  "items": ["forgejo-runner"]
                }
