                  "label": "sshd",
                  "ports": ["22"]
                }
              ]
            },
            {
              "id": "lan.gems.docker",
              "kind": "runtime",
              "label": "Docker",
              "children": [
                {
                  "id": "lan.gems.docker.netns",
                  "kind": "group",
                  "label": "host network",
                  "children": [
                    {
                      "id": "lan.gems.docker.netns.gsync",
