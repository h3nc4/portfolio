---
// A handset mock in neutral greys, so it reads as an object rather than part of the palette
import { cn } from '@/lib/utils'

interface Props {
  readonly screenClass?: string
  readonly class?: string
  readonly [data: `data-${string}`]: unknown
}

const { screenClass, class: className, ...rest } = Astro.props
---

{/* One cap for every handset, so phones shown side by side share a scale */}
<div
  class={cn('relative mx-auto w-full max-w-80', className)}
  data-testid="device-frame-container"
  {...rest}
>
  {/* One pill frame for every badge, so pills side by side share a height */}
  <div class="absolute -top-12 right-0 left-0 z-20 flex justify-center">
    <div
      data-testid="phone-badge"
      class="border-dawn-line bg-dawn-ground/80 text-dawn-taupe inline-flex items-center rounded-full border font-mono text-xs whitespace-nowrap shadow-xl backdrop-blur-md"
    >
      <slot name="badge" />
    </div>
  </div>

  {/* Outer shell, a hairline lighter than the body so the edge catches light */}
  <div
    class="relative rounded-[2.6rem] bg-linear-to-b from-neutral-500 to-neutral-700 p-[3px] shadow-2xl"
  >
    {/* Body, the grey bezel with a wider chin below the screen */}
    <div class="rounded-[2.45rem] bg-neutral-900 px-[10px] pt-[26px] pb-[20px]">
      {/* Earpiece and camera */}
      <div class="absolute top-[13px] right-0 left-0 flex items-center justify-center gap-2">
        <span class="h-[4px] w-10 rounded-full bg-neutral-800"></span>
        <span
          class="flex h-[8px] w-[8px] items-center justify-center rounded-full bg-neutral-950 ring-1 ring-neutral-700"
        >
          <span class="h-[3px] w-[3px] rounded-full bg-neutral-600"></span>
        </span>
      </div>

      <div
        class={cn(
          'relative aspect-9/21 w-full overflow-hidden rounded-[1.7rem] bg-black',
          screenClass,
        )}
      >
        <slot />
      </div>

      {/* Home bar on the chin */}
      <div class="mx-auto mt-[11px] h-[4px] w-24 rounded-full bg-neutral-700"></div>
    </div>
  </div>
</div>
