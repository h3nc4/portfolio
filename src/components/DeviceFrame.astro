---
// Interactive content in an iframe inside a handset mock. `siblings.ts` boots it once the page is idle.
import PhoneShell from '@/components/PhoneShell.astro'

interface Props {
  /** The sibling host the frame shows, as in wasudoku for wasudoku.h3nc4.com. */
  readonly sibling: string
  readonly title: string
  readonly class?: string
  /** Scales the content, so 0.7 hands the app a viewport about 420px wide. */
  readonly zoom?: number
}

const { sibling, title, class: className, zoom = 0.7 } = Astro.props
---

<PhoneShell screenClass="device-screen" class={className}>
  <span slot="badge" class="flex items-center gap-2 px-2 py-1.5">
    <span class="relative flex h-2 w-2" aria-hidden="true">
      <span
        data-testid="live-pulse"
        class="bg-dawn-accent absolute inline-flex h-full w-full animate-ping rounded-full opacity-75"
      ></span>
      <span class="bg-dawn-accent-hi relative inline-flex h-2 w-2 rounded-full"></span>
    </span>
    <span>Live Interactive Preview</span>
  </span>
  <iframe
    title={title}
    class="border-0 bg-black"
    style={`--device-zoom: ${zoom}`}
    loading="eager"
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
    allowfullscreen
    data-sibling-src={sibling}></iframe>
</PhoneShell>
