// The featured pair under one heading, side by side on wide screens, HyperGesture first
import DeviceFrame from '@/components/DeviceFrame.astro'
import HyperGesturePreview from '@/components/HyperGesturePreview.astro'
import Reveal from '@/components/Reveal.astro'
import FeaturedProject from '@/components/sections/FeaturedProject.astro'
import SectionHeading from '@/components/sections/SectionHeading.astro'
import { HYPERGESTURE, WASUDOKU } from '@/data/featured'

/** Text animation stagger between the two columns, in seconds. */
const COLUMN_STAGGER = 0.1
---

<section>
  <Reveal>
    <SectionHeading title="Featured Projects" rule="bg-dawn-line" class="mb-10" />
  </Reveal>

  <div class="grid gap-16 lg:grid-cols-2 lg:gap-x-12 lg:gap-y-10">
    <FeaturedProject project={HYPERGESTURE}>
      <HyperGesturePreview slot="preview" />
    </FeaturedProject>
    <FeaturedProject project={WASUDOKU} delay={COLUMN_STAGGER}>
      <DeviceFrame slot="preview" sibling="wasudoku" title="WASudoku Live Preview" />
    </FeaturedProject>
  </div>
</section>
