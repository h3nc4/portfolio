// The repository groups that share one idea. A card each would repeat the same sentence, so
// each family is a column of rows.
import Reveal from '@/components/Reveal.astro'
import SectionHeading from '@/components/sections/SectionHeading.astro'
import { EXTRAS, FAMILIES } from '@/data/projects'

const SMALL_LINK = 'text-dawn-taupe hover:text-dawn-accent text-sm font-light transition-colors'
const LINKS = [...EXTRAS, { title: 'all of it on cgit', url: 'https://cgit.h3nc4.com' }]
---

<section>
  <Reveal delay={0.2} threshold={0.2}>
    <SectionHeading title="Repository Families" rule="bg-dawn-line" />
    <p class="text-dawn-taupe mb-8 max-w-prose font-light">
      Each family is one idea repeated for a different goal.
    </p>
  </Reveal>

  <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-3 lg:gap-11">
    {FAMILIES.map((family, index) => (
      <Reveal delay={0.1 * index}>
        <h3 class="border-dawn-cream/15 text-dawn-stone mb-3 border-b pb-3 font-mono text-xs tracking-wider uppercase">
          {family.name}
        </h3>
        {family.items.map((item) => (
          <a
            href={item.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-baseline justify-between gap-4 py-2.5 text-sm transition-colors"
          >
            <span class="text-dawn-sand group-hover:text-dawn-accent font-mono text-sm transition-colors">
              {item.title}
            </span>
            <span class="text-dawn-stone text-right text-sm font-light">{item.what}</span>
          </a>
        ))}
      </Reveal>
    ))}
  </div>

  <Reveal delay={0.2}>
    <div class="mt-10 flex flex-wrap items-baseline gap-x-5 gap-y-2">
      <span class="text-dawn-stone font-mono text-xs tracking-wider uppercase">Smaller things</span>
      {LINKS.map((link) => (
        <a href={link.url} target="_blank" rel="noopener noreferrer" class={SMALL_LINK}>
          {link.title}
        </a>
      ))}
    </div>
  </Reveal>
</section>
