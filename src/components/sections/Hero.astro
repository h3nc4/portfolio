---
import { Mail } from 'lucide-react'
import { FaLinkedin } from 'react-icons/fa6'
import { SiGithub } from 'react-icons/si'

import Reveal from '@/components/Reveal.astro'
import ButtonLink from '@/components/ui/ButtonLink.astro'

const OUTLINE =
  'border-dawn-cream/30 bg-dawn-ground/55 hover:border-dawn-accent hover:text-dawn-accent gap-2 backdrop-blur-sm'
---

<Reveal>
  <section class="hero-body space-y-8">
    <div class="space-y-4">
      <h1
        class="text-dawn-cream text-[clamp(2.7rem,7vw,5rem)] leading-[1.03] font-normal tracking-tight [text-shadow:0_2px_26px_rgb(16_12_9_/_0.9)]"
      >
        Henrique Almeida
      </h1>
      <p
        class="text-dawn-sand max-w-[52ch] text-xl leading-relaxed font-light [text-shadow:0_1px_16px_rgb(16_12_9_/_0.9)]"
      >
        Software and DevOps engineer. Free software, GNU/Linux, and the UNIX philosophy.
      </p>
    </div>

    <div class="flex flex-wrap gap-4">
      <ButtonLink
        variant="outline"
        class={OUTLINE}
        href="https://github.com/h3nc4"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub profile"
      >
        <SiGithub className="h-4 w-4" aria-hidden="true" />
        GitHub
      </ButtonLink>
      <ButtonLink
        variant="outline"
        class={OUTLINE}
        href="https://linkedin.com/in/h3nc4"
        target="_blank"
        rel="noopener noreferrer"
      >
        <FaLinkedin className="h-4 w-4" aria-hidden="true" />
        LinkedIn
      </ButtonLink>
      <ButtonLink
        class="bg-dawn-accent text-dawn-ground hover:bg-dawn-accent-hi gap-2 font-medium"
        href="mailto:me@h3nc4.com"
      >
        <Mail className="h-4 w-4" />
        Contact Me
      </ButtonLink>
    </div>
  </section>
</Reveal>
