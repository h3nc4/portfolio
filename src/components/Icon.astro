// Drawn to static SVG at build time. The page gets the markup and none of the library.
import { Download, ExternalLink, GitBranch } from 'lucide-react'
import { SiGithub } from 'react-icons/si'

import type { FeaturedIcon } from '@/data/featured'
import { svg } from '@/lib/svg'

interface Props {
  readonly name: FeaturedIcon
  readonly className?: string
  readonly 'aria-hidden'?: 'true'
}

const ICONS = {
  download: Download,
  'external-link': ExternalLink,
  'git-branch': GitBranch,
  github: SiGithub,
}

const { name, ...rest } = Astro.props
---

<Fragment set:html={svg(ICONS[name], rest)} />
