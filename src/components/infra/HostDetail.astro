---
// What answers the hostname and one sentence on what it does, on the line below it. A label
// beside the name wrapped once the longest names outgrew a column, and read as a third field.
import type { Site } from '@/data/sites'

interface Props {
  readonly site: Site
}

const { site } = Astro.props
---

<span class="block text-sm leading-snug font-light"
  ><span class="text-dawn-sand font-mono text-xs tracking-wide">{site.serves}</span><span
    aria-hidden="true"
    class="text-dawn-stone">{' · '}</span
  ><span class="text-dawn-taupe">{site.about}</span></span
>
