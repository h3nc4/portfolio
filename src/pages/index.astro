---
import '@/index.css'

import ContainerPreviews from '@/components/sections/ContainerPreviews.astro'
import FeaturedProjects from '@/components/sections/FeaturedProjects.astro'
import Footer from '@/components/sections/Footer.astro'
import Hero from '@/components/sections/Hero.astro'
import Infrastructure from '@/components/sections/Infrastructure.astro'
import ProjectFamilies from '@/components/sections/ProjectFamilies.astro'
import SelectedProjects from '@/components/sections/SelectedProjects.astro'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Henrique Almeida</title>

    <meta name="description" content="Personal portfolio website." />
    <link rel="manifest" href="/manifest.json" />
    <link rel="preload" as="image" href="/landscape.webp" fetchpriority="high" />

    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#141414" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
    <link rel="apple-touch-icon" href="/icon-192.png" />

    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Henrique Almeida" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Henrique Almeida" />
    <meta property="og:url" content="https://h3nc4.com/" />
    <meta property="og:title" content="Henrique Almeida" />
    <meta property="og:description" content="Portfolio of Henrique Almeida." />
    <meta property="og:image" content="https://h3nc4.com/preview.png" />
    <meta property="og:image:secure_url" content="https://h3nc4.com/preview.png" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://h3nc4.com/" />
    <meta property="twitter:title" content="Henrique Almeida" />
    <meta property="twitter:description" content="Portfolio of Henrique Almeida." />
    <meta property="twitter:image" content="https://h3nc4.com/preview.png" />

    {/* Entrances wait on the script, so without one the content shows at rest */}
    <noscript>
      <style>
        .reveal {
          opacity: 1;
          transform: none;
        }
      </style>
    </noscript>
  </head>

  <body>
    {/* clip, not hidden: hidden on one axis makes the other a scroll container */}
    <div class="relative min-h-screen w-full overflow-x-clip">
      <div class="mx-auto max-w-7xl px-6">
        <main>
          {/* A full viewport, so scrolling to the top shows the painting uncovered */}
          <section class="hero-pin flex items-center">
            <Hero />
          </section>

          <div class="hero-sheet">
            <div id="featured" class="panel scroll-mt-8 p-6 sm:p-9 lg:p-11">
              <FeaturedProjects />
            </div>

            <div id="selected-projects" class="panel mt-8 scroll-mt-8 p-6 sm:p-9 lg:p-11">
              <SelectedProjects />
            </div>

            <div id="containers" class="panel mt-8 scroll-mt-8 p-6 sm:p-9 lg:p-11">
              <ContainerPreviews />
            </div>

            <div id="infrastructure" class="panel mt-8 scroll-mt-8 p-6 sm:p-9 lg:p-11">
              <Infrastructure />
            </div>

            <div id="repository-families" class="panel mt-8 scroll-mt-8 p-6 sm:p-9 lg:p-11">
              <ProjectFamilies />
            </div>
          </div>
        </main>

        <Footer />
      </div>
    </div>

    <script>
      import '@/scripts/main'
    </script>
  </body>
</html>
