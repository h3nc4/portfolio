# The cache policy nginx.conf used to carry, now that the edge serves these.
# Vite copies this file into dist, where Cloudflare reads it and does not serve it.

/
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

# Vite fingerprints everything under here, so a name never changes meaning.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The two files http-static served, typed so a browser shows them as text.
/dreamweaver.asc
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

/gpl-3.0.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400
