{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "reviewers": ["h3nc4"],
  "assignAutomerge": true,
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "lockFileMaintenance": {
    "enabled": true,
    "addLabels": ["automerge"],
    "automerge": true,
    "schedule": ["before 4am"]
  },
  "vulnerabilityAlerts": {
    "description": "Deliberately unscheduled: advisory fixes should not wait for the nightly window",
    "enabled": true,
    "addLabels": ["automerge", "security"],
    "automerge": true,
    "platformAutomerge": true
  },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "groupName": "radix-ui",
      "matchPackageNames": ["/^@radix-ui/", "/^radix-ui/"]
    },
    {
      "groupName": "react",
      "matchPackageNames": ["/^react/", "/^@types/react/"]
    },
    {
      "groupName": "vite-ecosystem",
      "matchPackageNames": [
        "/^vite/",
        "/^vitest/",
        "/^@vitejs/",
        "/^@vitest/",
        "/^playwright/",
        "/^@playwright/"
      ]
    },
    {
      "groupName": "eslint",
      "matchPackageNames": [
        "/^eslint/",
        "/^@eslint/",
        "/^typescript-eslint/",
        "/^@typescript-eslint/"
      ]
    },
    {
      "groupName": "tailwind",
      "matchPackageNames": ["/^tailwindcss/", "/^@tailwindcss/", "/^prettier-plugin-tailwindcss/"]
    },
    {
      "description": "Group SonarQube server and scanner updates",
      "groupName": "sonarqube",
      "matchPackageNames": ["sonarqube", "sonarsource/sonar-scanner-cli"]
    },
    {
      "description": "Disable unwanted pinning for SonarQube images",
      "matchPackageNames": ["sonarqube", "sonarsource/sonar-scanner-cli"],
      "pinDigests": false
    },
    {
      "description": "The dev container pin belongs to CI, not to Renovate.",
      "matchManagers": ["devcontainer"],
      "enabled": false
    },
    {
      "description": "Auto-merge all minor, patch, pin, and digest updates",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "addLabels": ["automerge"],
      "automerge": true,
      "platformAutomerge": true
    }
  ],
  "customManagers": [
    {
      "description": "Update Docker images in sonar script",
      "customType": "regex",
      "managerFilePatterns": ["/^scripts/sonar\\.sh$/"],
      "matchStrings": ["_image=\"(?<depName>.*?):(?<currentValue>.*?)\""],
      "datasourceTemplate": "docker"
    },
    {
      "description": "Update Rust version in CI/Dev Dockerfiles",
      "customType": "regex",
      "managerFilePatterns": ["/^docker/dev\\.Dockerfile$/"],
      "matchStrings": ["ARG RUST_VERSION=\"(?<currentValue>.*?)\""],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "rust-lang/rust"
    },
    {
      "description": "Update Node version in CI/Dev Dockerfiles",
      "customType": "regex",
      "managerFilePatterns": ["/^docker/dev\\.Dockerfile$/"],
      "matchStrings": ["ARG NODE_VERSION=\"(?<currentValue>.*?)\""],
      "datasourceTemplate": "node-version",
      "depNameTemplate": "node"
    }
  ]
}
